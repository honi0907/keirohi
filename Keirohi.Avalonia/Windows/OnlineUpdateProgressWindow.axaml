<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Keirohi.Avalonia.Windows.OnlineUpdateProgressWindow"
        Title="オンライン更新"
        Width="420"
        Height="160"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
    <ProgressBar x:Name="ProgressBar" MinHeight="8" Minimum="0" Maximum="100"/>
    <TextBlock Opacity="0.65" FontSize="12" Text="完了するまでこのウィンドウを閉じないでください。" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
