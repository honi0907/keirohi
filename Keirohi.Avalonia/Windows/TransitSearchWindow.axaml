<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Keirohi.Avalonia.Windows.TransitSearchWindow"
        Width="960"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock x:Name="RouteLabel"
               DockPanel.Dock="Top"
               FontWeight="SemiBold"
               FontSize="14"
               Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top"
               Text="表示された運賃を確認し、入力画面の「金額」に手で入力してください（APIキー不要）。"
               Opacity="0.65"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>
    <WebView x:Name="SearchWebView"/>
  </DockPanel>
</Window>
