<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Keirohi.Avalonia.Controls.SuicaDocumentPreview">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Viewbox x:Name="FitBox" Stretch="Uniform" HorizontalAlignment="Center">
      <Border x:Name="SheetBorder" Background="White" BorderBrush="Black" BorderThickness="1">
        <Grid x:Name="SheetGrid"/>
      </Border>
    </Viewbox>
  </ScrollViewer>
</UserControl>
