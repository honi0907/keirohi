<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Keirohi.Avalonia.Controls"
             xmlns:models="clr-namespace:Keirohi.Avalonia.Models"
             x:Class="Keirohi.Avalonia.Controls.RegistrationPreviewPanel"
             VerticalAlignment="Stretch">
  <Grid ColumnDefinitions="*,2*" VerticalAlignment="Stretch">
    <Border Grid.Column="0" Grid.Row="0" Margin="0,0,4,0" Padding="8" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RegisterColumn" Spacing="8">
          <TextBlock x:Name="InactiveRegisterHint" FontSize="11" Opacity="0.65" Text="入力または&#x0a;パターン画面で利用" TextWrapping="Wrap" IsVisible="False"/>
          <TextBlock x:Name="InputRegisterHint" FontSize="11" Opacity="0.75" Text="左の区間を入力し&#x0a;「明細に登録」で追加" TextWrapping="Wrap" IsVisible="False"/>
          <controls:RoutePatternApplyPanel x:Name="PatternApplyPanel" IsVisible="False"/>
          <controls:InlineMessageBanner x:Name="RegisterMessageBanner"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1" Grid.Row="0" Margin="4,0,0,0" Padding="8" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" Margin="0,0,0,8">
          <StackPanel Spacing="8">
            <TextBlock FontSize="12" Opacity="0.85" Text="保存セット" TextWrapping="Wrap"/>
            <ComboBox x:Name="EntrySetCombo" HorizontalAlignment="Stretch" SelectionChanged="EntrySetCombo_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="新規セット" FontSize="12" Click="NewEntrySet_Click"/>
              <Button Content="名前変更" FontSize="12" Click="RenameEntrySet_Click"/>
              <Button Content="削除" FontSize="12" Click="DeleteEntrySet_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
          <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Border x:Name="DateOrderWarningBorder" Padding="8,6" CornerRadius="4" BorderThickness="1" IsVisible="False"
                  Background="#FFFFF4CE" BorderBrush="#FF797673">
            <TextBlock x:Name="DateOrderWarningText" FontSize="12" TextWrapping="Wrap"/>
          </Border>
          <Border x:Name="EntryLimitWarningBorder" Padding="8,6" CornerRadius="4" BorderThickness="1" IsVisible="False"
                  Background="#FFF3F2F1" BorderBrush="#FF0078D4">
            <StackPanel Spacing="6">
              <TextBlock x:Name="EntryLimitWarningText" FontSize="12" TextWrapping="Wrap"/>
              <Button HorizontalAlignment="Left" Content="出力画面を開く" FontSize="12" Click="GoToExportPage_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="編集" Click="EditSelected_Click"/>
            <Button Content="↑" Click="MoveUp_Click"/>
            <Button Content="↓" Click="MoveDown_Click"/>
            <Button Content="削除" Click="DeleteSelected_Click"/>
            <Button Content="すべて削除" Click="ClearAll_Click"/>
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
          <ListBox x:Name="EntryList" Padding="0" SelectionChanged="EntryList_SelectionChanged"
                   ToolTip.Tip="行をドラッグして並べ替え">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:TripEntryItem">
                <Border Margin="{Binding ItemMargin}" Padding="8,4" Background="{Binding RowBackground}"
                        BorderBrush="{Binding SelectionBorderBrush}"
                        BorderThickness="{Binding SelectionBorderThickness}" CornerRadius="4">
                  <StackPanel Spacing="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding RouteSummary}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding AmountText}"/>
                    </Grid>
                    <TextBlock Opacity="0.8" Text="{Binding Line2}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
