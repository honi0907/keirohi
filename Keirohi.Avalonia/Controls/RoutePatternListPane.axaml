<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Keirohi.Avalonia.Models"
             x:Class="Keirohi.Avalonia.Controls.RoutePatternListPane"
             HorizontalAlignment="Stretch">
  <Grid Margin="6,6,6,4" RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="パターン一覧" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Padding="6,3" Content="新規" FontSize="11" Click="NewPattern_Click"/>
        <Button Padding="6,3" Content="削除" FontSize="11" Click="DeletePattern_Click"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="PatternCountText" Grid.Row="1" Margin="0,0,0,2" FontSize="12" Opacity="0.85" Text="0 件"/>
    <ListBox x:Name="PatternList" Grid.Row="2" Padding="0" SelectionChanged="PatternList_SelectionChanged"
             DoubleTapped="PatternList_DoubleTapped"
             ToolTip.Tip="行をドラッグして並べ替え。右クリックで色を設定">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="MinHeight" Value="36"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ContextMenu>
        <ContextMenu x:Name="ColorContextMenu"/>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:RoutePatternListRow">
          <Border Background="{Binding RowBackgroundBrush}" BorderBrush="{Binding SelectionBorderBrush}"
                  BorderThickness="{Binding SelectionBorderThickness}" CornerRadius="4">
            <Grid ColumnDefinitions="6,*">
              <Border Grid.Column="0" Background="{Binding AccentBarBrush}"/>
              <Grid Grid.Column="1" Margin="8,2,10,2" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="0">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="11" Opacity="0.75" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Opacity="0.9" Text="{Binding AmountText}"/>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
