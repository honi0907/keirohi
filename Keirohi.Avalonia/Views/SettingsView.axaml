<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Keirohi.Avalonia.Views.SettingsView">
  <ScrollViewer Padding="16,12,16,20">
    <StackPanel MaxWidth="400" Spacing="12">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="設定"/>
      <TextBox x:Name="CardLabelBox" Watermark="Suica カード表示（明細右上）"/>
      <TextBlock Opacity="0.85" Text="明細下段の日付"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <CalendarDatePicker x:Name="StatementDatePicker" Grid.Column="0"
                            HorizontalAlignment="Stretch" MinHeight="36"
                            Watermark="日付を選択" IsTodayHighlighted="True"/>
        <Button Grid.Column="1" Content="今日" MinHeight="36" VerticalAlignment="Stretch"
                Click="StatementDateToday_Click"/>
      </Grid>
      <TextBlock Opacity="0.85" Text="外観"/>
      <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" MinHeight="36"
                SelectionChanged="ThemeCombo_SelectionChanged">
        <ComboBoxItem Content="システムに合わせる" Tag="System"/>
        <ComboBoxItem Content="ライト" Tag="Light"/>
        <ComboBoxItem Content="ダーク" Tag="Dark"/>
      </ComboBox>
      <CheckBox x:Name="AutoFillFareToggle" Content="運賃の自動入力"/>
      <TextBlock Opacity="0.75" Text="オンにすると、出発・到着の入力時に過去に覚えた運賃を金額欄へ入れます。一度入力した区間の金額は自動で記憶され、手動で直した場合も上書きして記憶します。" TextWrapping="Wrap"/>
      <Button Content="運賃の履歴…" HorizontalAlignment="Left" MinHeight="36" Click="FareHistory_Click"/>
      <CheckBox x:Name="ShowSuicaPreviewPngAndPrintToggle" Content="明細プレビューで PNG 保存と印刷を表示"/>
      <TextBlock Opacity="0.75" Text="オフ（初期設定）のときは PDF 保存のみ表示します。位置の細かい調整が必要なときだけオンにしてください。" TextWrapping="Wrap"/>
      <Button Content="保存" Click="Save_Click" Classes="accent"/>
      <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Google Drive 同期（推奨）"/>
          <TextBlock Opacity="0.75" Text="モバイル Web と同じ Drive フォルダ内の JSON（entry-sets / patterns / fare-memory）を同期します。PC だけ settings.json も同期。初回は docs/google-drive-setup.md の OAuth 設定が必要です。" TextWrapping="Wrap"/>
          <TextBlock x:Name="DriveSyncStatusText" Opacity="0.85" TextWrapping="Wrap"/>
          <TextBox x:Name="DriveFolderBox" IsReadOnly="True" Watermark="同期フォルダ（未設定）"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="DriveConnectButton" Content="Google でログイン" MinHeight="36" Click="DriveConnect_Click"/>
            <Button x:Name="DrivePickFolderButton" Content="フォルダを選ぶ" MinHeight="36" Click="DrivePickFolder_Click"/>
          </StackPanel>
          <Button x:Name="DriveSyncNowButton" Content="今すぐ同期" MinHeight="36" Classes="accent" Click="DriveSyncNow_Click"/>
          <Button x:Name="DriveDisconnectButton" Content="接続を解除" MinHeight="36" Click="DriveDisconnect_Click"/>
          <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="ローカルデータ"/>
          <TextBlock x:Name="LocalBackupStatusText" Opacity="0.75" TextWrapping="Wrap"/>
          <Button x:Name="RestoreLocalButton" Content="同期前のローカルデータに戻す" MinHeight="36" Click="RestoreLocal_Click"/>
          <TextBlock Opacity="0.65" FontSize="11" Text="「今すぐ同期」の直前に自動で退避したデータに戻します。" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="手動（JSON ファイル）"/>
          <TextBlock Opacity="0.75" Text="Drive が使えないときの予備。モバイル Web と同じ JSON 形式です（設定は含みません）。" TextWrapping="Wrap"/>
          <Button Content="JSON を書き出す…" MinHeight="36" Click="ManualShareExport_Click"/>
          <Button Content="JSON を取り込む…" MinHeight="36" Click="ManualShareImport_Click"/>
        </StackPanel>
      </Border>
      <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="オンライン更新"/>
          <TextBlock x:Name="VersionText" Opacity="0.8" TextWrapping="Wrap"/>
          <Button Content="更新履歴…" HorizontalAlignment="Left" MinHeight="36" Click="ReleaseNotesHistory_Click"/>
          <Button x:Name="CheckUpdateButton" Content="更新を確認" Click="CheckUpdate_Click"/>
          <TextBlock x:Name="UpdateStatusText" Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
