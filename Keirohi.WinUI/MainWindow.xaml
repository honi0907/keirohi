<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Keirohi_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Keirohi_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="交通費入力"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="交通費入力"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid
                x:Name="ContentLayout"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Width="1380"
                Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition x:Name="EditorColumn" Width="672" />
                    <ColumnDefinition x:Name="FareColumn" Width="0" />
                    <ColumnDefinition Width="520" />
                </Grid.ColumnDefinitions>

                <Grid Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <NavigationView
                        x:Name="NavView"
                        Grid.Row="0"
                        MaxHeight="280"
                        VerticalAlignment="Top"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="188"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged">
                        <NavigationView.MenuItems>
                            <NavigationViewItem Content="入力" IsSelected="True" Tag="input">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="出力" Tag="export">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="パターン" Tag="patterns">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="設定" Tag="settings">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                        <Grid Width="0" Height="0" Opacity="0" />
                    </NavigationView>

                    <Border
                        x:Name="PatternPaneSeparator"
                        Grid.Row="1"
                        Margin="12,4,12,0"
                        VerticalAlignment="Top"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed" />

                    <controls:RoutePatternListPane
                        x:Name="PatternListPane"
                        Grid.Row="2"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="EditorColumnTitle"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="12,10,12,8"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="区間を入力"
                    Visibility="Collapsed" />

                <Grid Grid.Row="0" Grid.Column="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="4,10,0,8"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="明細への登録"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="4,10,8,8"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="登録結果"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="8,0,8,10"
                    VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="672" />
                        <ColumnDefinition Width="520" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource KeirohiPanelBorderThickness}"
                        CornerRadius="8">
                        <Grid VerticalAlignment="Stretch">
                            <Frame
                                x:Name="NavFrame"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch" />
                            <controls:RoutePatternEditorPanel
                                x:Name="PatternEditorHost"
                                Margin="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <controls:RegistrationPreviewPanel
                        x:Name="RegistrationPreview"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        VerticalAlignment="Stretch" />

                    <Button
                        x:Name="SavePatternButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        MinHeight="40"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Stretch"
                        Click="SavePatternButton_Click"
                        Content="パターンを保存"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed" />

                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RegisterToEntriesButton"
                            Grid.Column="0"
                            MinHeight="40"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            Click="RegisterToEntriesButton_Click"
                            Content="明細に登録"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="PdfSaveButton"
                            Grid.Column="1"
                            MinHeight="40"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            Click="PdfSaveButton_Click"
                            Content="PDFで保存…"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="LastSavedText"
                Margin="12,0,0,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="10"
                Opacity="0.65"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</Window>
