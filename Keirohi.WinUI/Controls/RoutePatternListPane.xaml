<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Keirohi_App.Controls.RoutePatternListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Keirohi_App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Padding="8,8,8,8" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Text="パターン一覧"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    MinWidth="0"
                    Padding="6,3"
                    Click="NewPattern_Click"
                    Content="新規"
                    FontSize="11" />
                <Button
                    MinWidth="0"
                    Padding="6,3"
                    Click="DeletePattern_Click"
                    Content="削除"
                    FontSize="11" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="PatternCountText"
            Grid.Row="1"
            FontSize="12"
            Opacity="0.85"
            Text="0 件" />

        <ListView
            x:Name="PatternList"
            Grid.Row="2"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="PatternList_DragItemsCompleted"
            DragItemsStarting="PatternList_DragItemsStarting"
            DragOver="PatternList_DragOver"
            Drop="PatternList_Drop"
            IsItemClickEnabled="True"
            ItemClick="PatternList_ItemClick"
            RightTapped="PatternList_RightTapped"
            SelectionChanged="PatternList_SelectionChanged"
            SelectionMode="Single"
            ToolTipService.ToolTip="行をドラッグして並べ替え。右クリックで色を設定">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RoutePatternListRow">
                    <Border
                        Background="{x:Bind RowBackgroundBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                        BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                        CornerRadius="4">
                        <Grid>
                            <Border
                                Width="6"
                                HorizontalAlignment="Left"
                                Background="{x:Bind AccentBarBrush, Mode=OneWay}" />
                            <Grid Padding="10,4,16,4" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.75"
                                        Text="{x:Bind Detail, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.9"
                                    Text="{x:Bind AmountText, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
