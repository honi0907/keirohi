<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Keirohi_App.Controls.RegistrationPreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Keirohi_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:Keirohi_App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,4,0"
            Padding="8,8,8,8"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="{StaticResource KeirohiPanelBorderThickness}"
            CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RegisterColumn" HorizontalAlignment="Stretch" Spacing="8">
                    <TextBlock
                        x:Name="InactiveRegisterHint"
                        FontSize="11"
                        Opacity="0.65"
                        Text="入力または&#x0a;パターン画面で利用"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="InputRegisterHint"
                        FontSize="11"
                        Opacity="0.75"
                        Text="左の区間を入力し&#x0a;「明細に登録」で追加"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                    <controls:RoutePatternApplyPanel
                        x:Name="PatternApplyPanel"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed" />
                    <controls:InlineMessageBanner x:Name="RegisterMessageBanner" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Column="1"
            Margin="4,0,0,0"
            Padding="8,8,8,8"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="{StaticResource KeirohiPanelBorderThickness}"
            CornerRadius="6">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border
                    Padding="8,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="{StaticResource KeirohiCardBorderThickness}"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.85"
                            Text="保存セット"
                            ToolTipService.ToolTip="月の前半・後半などに切り替え"
                            TextWrapping="WrapWholeWords" />
                        <ComboBox
                            x:Name="EntrySetCombo"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label"
                            SelectionChanged="EntrySetCombo_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="NewEntrySet_Click" Content="新規セット" FontSize="12" />
                            <Button Click="RenameEntrySet_Click" Content="名前変更" FontSize="12" />
                            <Button Click="DeleteEntrySet_Click" Content="削除" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock
                        x:Name="SummaryText"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <Border
                        x:Name="DateOrderWarningBorder"
                        Padding="8,6"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="DateOrderWarningText"
                            FontSize="12"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                    <Border
                        x:Name="EntryLimitWarningBorder"
                        Padding="8,6"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="EntryLimitWarningText"
                                FontSize="12"
                                TextWrapping="WrapWholeWords" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="GoToExportPage_Click"
                                Content="出力画面を開く"
                                FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Padding="8,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="{StaticResource KeirohiCardBorderThickness}"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="EditSelected_Click" Content="編集" />
                        <Button Click="MoveUp_Click" Content="↑" />
                        <Button Click="MoveDown_Click" Content="↓" />
                        <Button Click="DeleteSelected_Click" Content="削除" />
                        <Button Click="ClearAll_Click" Content="すべて削除" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="3"
                    Padding="4,4,4,6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="{StaticResource KeirohiCardBorderThickness}"
                    CornerRadius="4">
                    <ListView
                        x:Name="EntryList"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        ContainerContentChanging="EntryList_ContainerContentChanging"
                        DragItemsCompleted="EntryList_DragItemsCompleted"
                        DragItemsStarting="EntryList_DragItemsStarting"
                        DragOver="EntryList_DragOver"
                        Drop="EntryList_Drop"
                        SelectionChanged="EntryList_SelectionChanged"
                        SelectionMode="Single"
                        ToolTipService.ToolTip="行をドラッグして並べ替え">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TripEntryItem">
                                <Border
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    Background="{x:Bind RowBackground, Mode=OneWay}"
                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                    CornerRadius="4">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind RouteSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind AmountText, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Opacity="0.8" Text="{x:Bind Line2}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
