<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Keirohi_App.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,12,16,24" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Spacing="14">
            <TextBlock
                x:Name="LimitText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource KeirohiCardBorderThickness}"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="区間" />
                    <TextBlock
                        Opacity="0.75"
                        Text="定例ルートは左メニュー「パターン」から登録・明細への一括登録ができます。"
                        TextWrapping="WrapWholeWords" />
                    <CalendarDatePicker
                        x:Name="DatePicker"
                        HorizontalAlignment="Stretch"
                        Header="日付"
                        IsTodayHighlighted="True"
                        PlaceholderText="日付を選択" />
                    <TextBox x:Name="DestinationBox" Header="目的地（精算用）" />
                    <TextBox x:Name="DepartureBox" Header="出発" TextChanged="StationFields_TextChanged" />
                    <TextBox x:Name="ArrivalBox" Header="到着" TextChanged="StationFields_TextChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ModeBox"
                            Grid.Column="0"
                            Header="種別"
                            SelectedIndex="0"
                            SelectionChanged="ModeBox_SelectionChanged">
                            <ComboBoxItem Content="電車" Tag="train" />
                            <ComboBoxItem Content="バス等" Tag="bus" />
                        </ComboBox>
                        <TextBox
                            x:Name="AmountBox"
                            Grid.Column="1"
                            Header="金額（円）"
                            InputScope="Number"
                            LostFocus="AmountBox_LostFocus"
                            TextChanged="AmountBox_TextChanged" />
                    </Grid>
                    <TextBlock x:Name="FareHint" Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <Button
                        Click="OpenYahooTransit_Click"
                        HorizontalAlignment="Left"
                        Content="Yahoo!乗換案内で調べる（APIキー不要）" />
                    <TextBox x:Name="NoteBox" Header="備考" AcceptsReturn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
