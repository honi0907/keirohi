<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Keirohi_App.TransitSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Yahoo!乗換案内">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="12,10,12,0"
            Spacing="6">
            <TextBlock
                x:Name="RouteLabel"
                FontWeight="SemiBold"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Opacity="0.75"
                Text="表示された運賃を確認し、入力画面の「金額」に手で入力してください（APIキー不要）。"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <WebView2
            x:Name="SearchWebView"
            Grid.Row="1"
            Margin="8,0,8,8" />
    </Grid>
</Window>
