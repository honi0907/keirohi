<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Keirohi_App.SuicaPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Keirohi_App.Controls"
    Title="Suica 明細プレビュー（印刷用）">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,10,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.85"
                Text="印刷…の「余白の設定…」で、上下左右の余白を調整できます。"
                TextWrapping="WrapWholeWords" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="SavePng_Click" Content="PNG保存…" />
                <Button
                    Click="Print_Click"
                    Content="印刷…"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <controls:SuicaDocumentPreview
            x:Name="Preview"
            Grid.Row="1"
            Margin="8" />
    </Grid>
</Window>
